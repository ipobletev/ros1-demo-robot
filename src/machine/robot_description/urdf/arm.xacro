<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Incluir propiedades comunes para materiales (ya se incluye en robot.xacro, pero se añade para claridad) -->
  <xacro:include filename="$(find robot_description)/urdf/common_properties.xacro" />

  <!-- Base del brazo (se conectará a la base del robot principal) -->
  <link name="arm_base_link">
    <visual>
      <geometry>
        <box size="0.15 0.15 0.03"/> <!-- Base más ancha y plana -->
      </geometry>
      <material name="grey"/> <!-- Usando material de common_properties -->
    </visual>
    <collision>
      <geometry>
        <box size="0.15 0.15 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.7"/>
      <inertia ixx="0.002" ixy="0.0" ixz="0.0"
               iyy="0.002" iyz="0.0"
               izz="0.002"/>
    </inertial>
  </link>

  <!-- Articulación del hombro (revolute para rotación horizontal) -->
  <joint name="shoulder_joint" type="revolute">
    <parent link="arm_base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.015" rpy="0 0 0"/> <!-- Posición encima de la base del brazo -->
    <axis xyz="0 0 1"/> <!-- Rotación alrededor del eje Z (horizontal) -->
    <limit lower="-1.8" upper="1.8" effort="100" velocity="0.5"/>
  </joint>

  <link name="shoulder_link">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.25"/> <!-- Cilindro para el segmento del brazo -->
      </geometry>
      <origin xyz="0 0 0.125" rpy="0 0 0"/> <!-- Centrar el cilindro para que extienda hacia arriba -->
      <material name="blue"/> <!-- Color diferente para el segmento -->
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.05" length="0.25"/>
      </geometry>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.0015" ixy="0.0" ixz="0.0"
               iyy="0.0015" iyz="0.0"
               izz="0.0015"/>
    </inertial>
  </link>

  <!-- Articulación del codo (revolute para rotación vertical) -->
  <joint name="elbow_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="elbow_link"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/> <!-- En la parte superior del eslabón del hombro -->
    <axis xyz="0 1 0"/> <!-- Rotación alrededor del eje Y (vertical) -->
    <limit lower="-1.8" upper="1.8" effort="100" velocity="0.5"/>
  </joint>

  <link name="elbow_link">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.20"/> <!-- Cilindro más pequeño -->
      </geometry>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.04" length="0.20"/>
      </geometry>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.0008" ixy="0.0" ixz="0.0"
               iyy="0.0008" iyz="0.0"
               izz="0.0008"/>
    </inertial>
  </link>

  <!-- Articulación de la muñeca (revolute para rotación vertical) -->
  <joint name="wrist_joint" type="revolute">
    <parent link="elbow_link"/>
    <child link="wrist_link"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/> <!-- En la parte superior del eslabón del codo -->
    <axis xyz="0 1 0"/> <!-- Rotación alrededor del eje Y (vertical) -->
    <limit lower="-1.8" upper="1.8" effort="100" velocity="0.5"/>
  </joint>

  <link name="wrist_link">
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.08"/> <!-- Cilindro aún más pequeño -->
      </geometry>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.03" length="0.08"/>
      </geometry>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.0002" ixy="0.0" ixz="0.0"
               iyy="0.0002" iyz="0.0"
               izz="0.0002"/>
    </inertial>
  </link>

  <!-- Efector final (puede ser un simple cubo o un gripper más complejo) -->
  <joint name="end_effector_joint" type="fixed">
    <parent link="wrist_link"/>
    <child link="end_effector_link"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/> <!-- Posición al final de la muñeca -->
  </joint>

  <link name="end_effector_link">
    <visual>
      <geometry>
        <box size="0.06 0.06 0.03"/> <!-- Caja simple para el efector final -->
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.06 0.06 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0"
               izz="0.0001"/>
    </inertial>
  </link>

</robot>