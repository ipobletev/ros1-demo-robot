<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Propiedades comunes para el brazo (puedes incluir common_properties.xacro si quieres) -->
  <!-- <xacro:include filename="$(find robot_description)/urdf/common_properties.xacro" /> -->

  <!-- Definición de materiales básicos para el brazo (si no usas common_properties) -->
  <material name="arm_grey">
    <color rgba="0.7 0.7 0.7 1"/>
  </material>
  <material name="arm_black">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>

  <!-- Base del brazo (se conectará a la base del robot principal) -->
  <link name="arm_base_link">
    <visual>
      <geometry>
        <box size="0.1 0.1 0.05"/>
      </geometry>
      <material name="arm_grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.1 0.1 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0"
               izz="0.001"/>
    </inertial>
  </link>

  <!-- Articulación del hombro (revolute para rotación horizontal) -->
  <joint name="shoulder_joint" type="revolute">
    <parent link="arm_base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.025" rpy="0 0 0"/> <!-- Encima de la base del brazo -->
    <axis xyz="0 0 1"/> <!-- Rotación alrededor del eje Z (horizontal) -->
    <limit lower="-1.57" upper="1.57" effort="100" velocity="0.5"/>
  </joint>

  <link name="shoulder_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.2"/>
      </geometry>
      <material name="arm_black"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.05 0.2"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0"
               izz="0.001"/>
    </inertial>
  </link>

  <!-- Articulación del codo (revolute para rotación vertical) -->
  <joint name="elbow_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="elbow_link"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/> <!-- En la parte superior del hombro -->
    <axis xyz="0 1 0"/> <!-- Rotación alrededor del eje Y (vertical) -->
    <limit lower="-1.57" upper="1.57" effort="100" velocity="0.5"/>
  </joint>

  <link name="elbow_link">
    <visual>
      <geometry>
        <box size="0.04 0.04 0.15"/>
      </geometry>
      <material name="arm_grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.04 0.04 0.15"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.0005" ixy="0.0" ixz="0.0"
               iyy="0.0005" iyz="0.0"
               izz="0.0005"/>
    </inertial>
  </link>

  <!-- Articulación de la muñeca (revolute para rotación vertical) -->
  <joint name="wrist_joint" type="revolute">
    <parent link="elbow_link"/>
    <child link="wrist_link"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/> <!-- En la parte superior del codo -->
    <axis xyz="0 1 0"/> <!-- Rotación alrededor del eje Y (vertical) -->
    <limit lower="-1.57" upper="1.57" effort="100" velocity="0.5"/>
  </joint>

  <link name="wrist_link">
    <visual>
      <geometry>
        <box size="0.03 0.03 0.05"/>
      </geometry>
      <material name="arm_black"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.03 0.03 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0"
               izz="0.0001"/>
    </inertial>
  </link>

  <!-- Puedes agregar un efector final (gripper, herramienta, etc.) aquí si lo deseas -->
  <!-- Ejemplo de un efector final fijo -->
  <joint name="end_effector_joint" type="fixed">
    <parent link="wrist_link"/>
    <child link="end_effector_link"/>
    <origin xyz="0 0 0.025" rpy="0 0 0"/>
  </joint>

  <link name="end_effector_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.02"/>
      </geometry>
      <material name="arm_grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.05 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0"
               iyy="0.00005" iyz="0.0"
               izz="0.00005"/>
    </inertial>
  </link>

</robot>