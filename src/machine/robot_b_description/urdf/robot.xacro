<?xml version="1.0" encoding="utf-8"?>
<robot name="four_wheel_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Common properties - Materials -->
  <xacro:include filename="$(find robot_b_description)/urdf/common_properties.xacro" />

  <!-- Gazebo configuration -->
  <xacro:include filename="$(find robot_b_description)/urdf/robot.gazebo.xacro" />
  
  <!-- Link base_footprint (convención ROS para la base del robot) -->
  <link name="base_footprint"/>

  <!-- Joint que conecta base_footprint con base_link -->
  <joint name="base_joint" type="fixed">
    <origin xyz="0 0 0.2" rpy="0 0 0" />
    <parent link="base_footprint"/>
    <child link="base_link" />
  </joint>
  
  <!-- Link principal del robot (cuerpo central) -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.6 0.4 0.2"/> <!-- Un cubo simple para la base -->
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.6 0.4 0.2"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="10.0"/> <!-- Masa de la base -->
      <!-- Momentos de inercia para un cubo -->
      <inertia ixx="1.0" ixy="0.0" ixz="0.0"
               iyy="1.0" iyz="0.0"
               izz="1.0"/>
    </inertial>
  </link>

  <!-- Macro para definir una rueda, facilitando la creación de las cuatro -->
  <xacro:macro name="wheel" params="prefix parent_link x_offset y_offset z_offset">
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${parent_link}"/>
      <child link="${prefix}_wheel_link"/>
      <!-- rpy="-1.570795 0 0" rota la rueda para que el eje Z apunte hacia afuera (horizontal) -->
      <origin xyz="${x_offset} ${y_offset} ${z_offset} " rpy="-1.570795 0 0"/> 
      <axis xyz="0 0 1"/> <!-- El eje de rotación de la rueda es su propio eje Z local -->
    </joint>

    <link name="${prefix}_wheel_link">
      <visual>
        <geometry>
          <cylinder radius="0.1" length="0.05"/> <!-- Un cilindro para la rueda -->
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.1" length="0.05"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="0.5"/> <!-- Masa de la rueda -->
        <!-- Momentos de inercia para un cilindro -->
        <inertia ixx="0.002" ixy="0.0" ixz="0.0"
                 iyy="0.002" iyz="0.0"
                 izz="0.002"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- Instanciamos las cuatro ruedas usando la macro -->
  <!-- Rueda Delantera Izquierda -->
  <xacro:wheel prefix="front_left" parent_link="base_link" x_offset="0.2" y_offset="0.225" z_offset="-0.1"/>
  <!-- Rueda Delantera Derecha -->
  <xacro:wheel prefix="front_right" parent_link="base_link" x_offset="0.2" y_offset="-0.225" z_offset="-0.1"/>
  <!-- Rueda Trasera Izquierda -->
  <xacro:wheel prefix="back_left" parent_link="base_link" x_offset="-0.2" y_offset="0.225" z_offset="-0.1"/>
  <!-- Rueda Trasera Derecha -->
  <xacro:wheel prefix="back_right" parent_link="base_link" x_offset="-0.2" y_offset="-0.225" z_offset="-0.1"/>

</robot>