<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Include common properties for materials (already included in robot.xacro, but added for clarity) -->
  <xacro:include filename="$(find robot_a_description)/urdf/common_properties.xacro" />

  <!-- Arm base (will connect to the main robot base) -->
  <link name="arm_base_link">
    <visual>
      <geometry>
        <box size="0.15 0.15 0.03"/> <!-- Wider and flatter base -->
      </geometry>
      <material name="grey"/> <!-- Using material from common_properties -->
    </visual>
    <collision>
      <geometry>
        <box size="0.15 0.15 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.7"/>
      <inertia ixx="0.002" ixy="0.0" ixz="0.0"
               iyy="0.002" iyz="0.0"
               izz="0.002"/>
    </inertial>
  </link>

  <!-- Shoulder joint (revolute for horizontal rotation) -->
  <joint name="shoulder_joint" type="revolute">
    <parent link="arm_base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.015" rpy="0 0 0"/> <!-- Position above the arm base -->
    <axis xyz="0 0 1"/> <!-- Rotation around the Z-axis (horizontal) -->
    <limit lower="-1.8" upper="1.8" effort="100" velocity="0.5"/>
  </joint>

  <link name="shoulder_link">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.25"/> <!-- Cylinder for the arm segment -->
      </geometry>
      <origin xyz="0 0 0.125" rpy="0 0 0"/> <!-- Center the cylinder to extend upwards -->
      <material name="blue"/> <!-- Different color for the segment -->
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.05" length="0.25"/>
      </geometry>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.0015" ixy="0.0" ixz="0.0"
               iyy="0.0015" iyz="0.0"
               izz="0.0015"/>
    </inertial>
  </link>

  <!-- Elbow joint (revolute for vertical rotation) -->
  <joint name="elbow_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="elbow_link"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/> <!-- At the top of the shoulder link -->
    <axis xyz="0 1 0"/> <!-- Rotation around the Y-axis (vertical) -->
    <limit lower="-1.8" upper="1.8" effort="100" velocity="0.5"/>
  </joint>

  <link name="elbow_link">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.20"/> <!-- Smaller cylinder -->
      </geometry>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.04" length="0.20"/>
      </geometry>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.0008" ixy="0.0" ixz="0.0"
               iyy="0.0008" iyz="0.0"
               izz="0.0008"/>
    </inertial>
  </link>

  <!-- Wrist joint (revolute for vertical rotation) -->
  <joint name="wrist_joint" type="revolute">
    <parent link="elbow_link"/>
    <child link="wrist_link"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/> <!-- At the top of the elbow link -->
    <axis xyz="0 1 0"/> <!-- Rotation around the Y-axis (vertical) -->
    <limit lower="-1.8" upper="1.8" effort="100" velocity="0.5"/>
  </joint>

  <link name="wrist_link">
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.08"/> <!-- Even smaller cylinder -->
      </geometry>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.03" length="0.08"/>
      </geometry>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.0002" ixy="0.0" ixz="0.0"
               iyy="0.0002" iyz="0.0"
               izz="0.0002"/>
    </inertial>
  </link>

  <!-- End effector (can be a simple cube or a more complex gripper) -->
  <joint name="end_effector_joint" type="fixed">
    <parent link="wrist_link"/>
    <child link="end_effector_link"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/> <!-- Position at the end of the wrist -->
  </joint>

  <link name="end_effector_link">
    <visual>
      <geometry>
        <box size="0.06 0.06 0.03"/> <!-- Simple box for the end effector -->
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.06 0.06 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0"
               izz="0.0001"/>
    </inertial>
  </link>

</robot>